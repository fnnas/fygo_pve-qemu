Description: honor individual NVMe namespace boot priorities in SeaBIOS
 Matching only the controller PCI path assigns every namespace the priority
 of the first boot entry on that controller. Include the actual namespace ID
 in hexadecimal, matching QEMU firmware paths and the UEFI representation.
Forwarded: no

--- a/roms/seabios/src/boot.c
+++ b/roms/seabios/src/boot.c
@@ -316,6 +316,20 @@ int bootprio_find_pci_device(struct pci_
     return find_prio(desc);
 }
 
+int bootprio_find_nvme_device(struct pci_device *pci, u32 nsid)
+{
+    if (CONFIG_CSM) {
+        return csm_bootprio_pci(pci);
+    }
+    if (!CONFIG_BOOTORDER) {
+        return -1;
+    }
+    char desc[256];
+    char *p = build_pci_path(desc, sizeof(desc), "*", pci);
+    snprintf(p, desc + sizeof(desc) - p, "/namespace@%x,0", nsid);
+    return find_prio(desc);
+}
