+
+static void usb4_device_set_nvme_disconnected(Object *obj, bool disconnected,
+                                             Error **errp)
+{
+    USB4Device *d = USB4_DEVICE(obj);
+    USB4TunnelPort *port;
+
+    if (!DEVICE(d)->realized) {
+        d->nvme_disconnected = disconnected;
+        return;
+    }
+    if (!d->dock_nvme_hotplug) {
+        error_setg(errp, "The dock was started without x-dock-nvme-hotplug");
+        return;
+    }
+    if (d->nvme_disconnected == disconnected) {
+        return;
+    }
+    if (d->parent_dev) {
+        port = d->parent_dev->dfp_target[d->port];
+    } else {
+        port = d->parent ? NULL :
+               usb4_host_get_port_tunnel(d->host, d->port);
+    }
+    if (!usb4_tunnel_port_set_dock_nvme(port, d, disconnected, errp)) {
+        return;
+    }
+    d->nvme_disconnected = disconnected;
+}
