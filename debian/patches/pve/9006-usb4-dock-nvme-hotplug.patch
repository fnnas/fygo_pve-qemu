+static void test_dock_nvme_connection(void)
+{
+    QTestState *qts = qtest_init(
+        "-machine q35 "
+        "-blockdev driver=null-co,node-name=disk0,size=16777216 "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1 "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0,"
+        "preos-cm=on "
+        "-device usb4-device,id=dock0,bus=u4.0,dock=on,drive=disk0,"
+        "x-dock-nvme-hotplug=on,x-nvme-disconnected=on");
+    g_autoptr(QDict) before = qtest_qmp(qts, "{'execute': 'query-pci'}");
+    g_autoptr(QDict) after = NULL;
+
+    assert_dock_namespace(qts, false);
+    for (int i = 0; i < 2; i++) {
+        qtest_qmp_assert_success(
+            qts, "{'execute': 'qom-set', 'arguments': "
+            "{'path': 'dock0', 'property': 'x-nvme-disconnected', "
+            "'value': false}}");
+        assert_dock_namespace(qts, true);
+        qtest_qmp_assert_success(
+            qts, "{'execute': 'qom-set', 'arguments': "
+            "{'path': 'dock0', 'property': 'x-nvme-disconnected', "
+            "'value': true}}");
+        assert_dock_namespace(qts, false);
+    }
+    after = qtest_qmp(qts, "{'execute': 'query-pci'}");
+    g_assert_true(qobject_is_equal(QOBJECT(before), QOBJECT(after)));
+    qtest_quit(qts);
+}
