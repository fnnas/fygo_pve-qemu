+static void assert_dock_namespace(QTestState *qts, bool present)
+{
+    /* The removed namespace can retain its backend until RCU finalization. */
+    for (int i = 0; i < 200; i++) {
+        g_autoptr(QDict) rsp = qtest_qmp(qts, "{'execute': 'query-block'}");
+        QList *blocks = qdict_get_qlist(rsp, "return");
+        const QListEntry *entry;
+        bool found = false;
+
+        QLIST_FOREACH_ENTRY(blocks, entry) {
+            QDict *block = qobject_to(QDict, qlist_entry_obj(entry));
+            QDict *inserted = qdict_get_qdict(block, "inserted");
+
+            if (inserted &&
+                !g_strcmp0(qdict_get_try_str(inserted, "node-name"),
+                           "disk0") &&
+                qdict_haskey(block, "qdev")) {
+                found = true;
+            }
+        }
+        if (found == present) {
+            return;
+        }
+        g_usleep(1000);
+    }
+    g_error("Dock NVMe namespace did not become %s",
+            present ? "attached" : "detached");
+}
