+bool usb4_tunnel_port_set_dock_nvme(USB4TunnelPort *p, USB4Device *dev,
+                                   bool disconnected, Error **errp)
+{
+    USB4TunnelSlot *ts = p ? ts_from_object(OBJECT(p)) : NULL;
+    g_autofree char *path = object_get_canonical_path(OBJECT(dev));
+    PCIDevice *downstream, *nvme;
+    Error *local_err = NULL;
+
+    if (!ts || !ts_alive(ts) || ts->ep_state != EP_LIVE ||
+        !ts->tunnel_up || !ts->up_dock_nvme_hotplug ||
+        !ts_builds_switch(ts) ||
+        g_strcmp0(path, ts->up_dev_path)) {
+        error_setg(errp, "The dock's PCIe tunnel is not ready");
+        return false;
+    }
+    downstream = pci_bridge_get_sec_bus(PCI_BRIDGE(ts->ep))->devices[0];
+    nvme = downstream ?
+           pci_bridge_get_sec_bus(PCI_BRIDGE(downstream))->devices[0] : NULL;
+    if (!nvme) {
+        error_setg(errp, "The dock's NVMe controller is not present");
+        return false;
+    }
+    if (!usb4_tunnel_slot_lifecycle_begin(ts)) {
+        error_setg(errp, "The dock is busy changing its PCIe tunnel");
+        return false;
+    }
+    if (disconnected && ts->ns_devs->len) {
+        DeviceState *ns = g_ptr_array_index(ts->ns_devs, 0);
+
+        if (ns->realized) {
+            qdev_unplug(ns, &local_err);
+        }
+        if (!local_err && ts_alive(ts) &&
+            g_ptr_array_remove_fast(ts->ns_devs, ns)) {
+            object_unref(OBJECT(ns));
+        }
+    } else if (!disconnected) {
+        ts_create_dock_namespace(ts, DEVICE(nvme), ts->up_drive, true,
+                                 &local_err);
+    }
+    if (!local_err) {
+        ts->up_nvme_disconnected = disconnected;
+    }
+    usb4_tunnel_slot_lifecycle_end(ts);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return false;
+    }
+    return true;
+}
