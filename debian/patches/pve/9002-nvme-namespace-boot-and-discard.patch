diff --git a/roms/seabios-patches/0001-nvme-namespace-boot-order.patch b/roms/seabios-patches/0001-nvme-namespace-boot-order.patch
new file mode 100644
index 0000000000..c00d59d80d
--- /dev/null
+++ b/roms/seabios-patches/0001-nvme-namespace-boot-order.patch
@@ -0,0 +1,51 @@
+Description: honor individual NVMe namespace boot priorities in SeaBIOS
+ Matching only the controller PCI path assigns every namespace the priority
+ of the first boot entry on that controller. Include the actual namespace ID
+ in hexadecimal, matching QEMU firmware paths and the UEFI representation.
+Forwarded: no
+
+--- a/src/boot.c
++++ b/src/boot.c
+@@ -316,6 +316,20 @@ int bootprio_find_pci_device(struct pci_
+     return find_prio(desc);
+ }
+ 
++int bootprio_find_nvme_device(struct pci_device *pci, u32 nsid)
++{
++    if (CONFIG_CSM) {
++        return csm_bootprio_pci(pci);
++    }
++    if (!CONFIG_BOOTORDER) {
++        return -1;
++    }
++    char desc[256];
++    char *p = build_pci_path(desc, sizeof(desc), "*", pci);
++    snprintf(p, desc + sizeof(desc) - p, "/namespace@%x,0", nsid);
++    return find_prio(desc);
++}
++
+ int bootprio_find_mmio_device(void *mmio)
+ {
+     if (!CONFIG_BOOTORDER)
+--- a/src/hw/nvme.c
++++ b/src/hw/nvme.c
+@@ -311,7 +311,8 @@ nvme_probe_ns(struct nvme_ctrl *ctrl, u3
+                           ns->lba_count, ns->block_size, ns->metadata_size);
+ 
+     dprintf(3, "%s\n", desc);
+-    boot_add_hd(&ns->drive, desc, bootprio_find_pci_device(ctrl->pci));
++    boot_add_hd(&ns->drive, desc,
++                bootprio_find_nvme_device(ctrl->pci, ns_id));
+ 
+ free_buffer:
+     free (id);
+--- a/src/util.h
++++ b/src/util.h
+@@ -30,6 +30,7 @@ void bcv_prepboot(void);
+ u8 is_bootprio_strict(void);
+ struct pci_device;
+ int bootprio_find_pci_device(struct pci_device *pci);
++int bootprio_find_nvme_device(struct pci_device *pci, u32 nsid);
+ int bootprio_find_mmio_device(void *mmio);
+ int bootprio_find_scsi_device(struct pci_device *pci, int target, int lun);
+ int bootprio_find_scsi_mmio_device(void *mmio, int target, int lun);
diff --git a/roms/seabios-patches/0002-nvme-metadata.patch b/roms/seabios-patches/0002-nvme-metadata.patch
new file mode 100644
index 0000000000..faeb4e77a3
--- /dev/null
+++ b/roms/seabios-patches/0002-nvme-metadata.patch
@@ -0,0 +1,39 @@
+Description: keep unsupported NVMe metadata out of SeaBIOS disk I/O
+ SeaBIOS issues NVMe reads with a null metadata pointer. A namespace carrying
+ metadata can therefore DMA into low memory while its partition table is
+ probed, corrupting the interrupt vectors and BIOS data used to boot other
+ devices. Skip metadata namespaces in firmware, leaving access to guest
+ drivers with the required metadata support. Add a TCG boot regression with
+ an unsupported namespace ahead of a conventional boot disk.
+Forwarded: no
+
+--- a/src/hw/nvme.c
++++ b/src/hw/nvme.c
+@@ -260,6 +260,18 @@ nvme_probe_ns(struct nvme_ctrl *ctrl, u3
+         goto free_buffer;
+     }
+ 
++    struct nvme_lba_format *fmt = &id->lbaf[current_lba_format];
++    if (fmt->ms) {
++        /*
++         * INT 13h has no metadata buffer. Passing a null MPTR would DMA
++         * metadata into the interrupt vectors and BIOS data area, even
++         * when booting from another device. Leave this namespace to the OS.
++         */
++        dprintf(1, "NVMe NS %u: unsupported %u-byte metadata\n",
++                ns_id, fmt->ms);
++        goto free_buffer;
++    }
++
+     if (!nvme_dma_buffer) {
+         nvme_dma_buffer = zalloc_page_aligned(&ZoneHigh, NVME_PAGE_SIZE);
+         if (!nvme_dma_buffer) {
+@@ -278,8 +290,6 @@ nvme_probe_ns(struct nvme_ctrl *ctrl, u3
+     ns->ns_id = ns_id;
+     ns->lba_count = id->nsze;
+ 
+-    struct nvme_lba_format *fmt = &id->lbaf[current_lba_format];
+-
+     ns->block_size    = 1U << fmt->lbads;
+     ns->metadata_size = fmt->ms;
+ 
