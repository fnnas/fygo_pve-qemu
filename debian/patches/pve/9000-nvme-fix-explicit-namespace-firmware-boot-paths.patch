+typedef struct {
+    const char *name;
+    const char *args;
+    const char *expected;
+} NvmeBootPathTest;
+
+#define NVME_BOOT_CTRL "/pci@i0cf8/pci1b36,0010@4"
+#define NVME_BOOT_ARGS "-device nvme-subsys,id=ss " \
+    "-device nvme,id=ctrl,subsys=ss,serial=boot,addr=04,use-intel-id=off "
+
+static void assert_nvme_boot_path(QTestState *qts, const char *expected)
+{
+    g_autoptr(QFWCFG) fw_cfg = io_fw_cfg_init(qts, 0x510);
+    g_autofree char *expected_path = g_strdup(expected);
+    char order[1024] = { 0 };
+    size_t size = qfw_cfg_get_file(fw_cfg, "bootorder", order, sizeof(order));
+
+    g_assert_cmpuint(size, <=, sizeof(order));
+    g_strchomp(order);
+    g_strchomp(expected_path);
+    g_assert_cmpstr(order, ==, expected_path);
+}
+
+static void test_nvme_boot_path(const void *opaque)
+{
+    const NvmeBootPathTest *test = opaque;
+    QTestState *qts = qtest_initf(
+        "-M q35 -nodefaults -blockdev driver=null-co,node-name=disk,size=16777216 %s",
+        test->args);
+
+    assert_nvme_boot_path(qts, test->expected);
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, test->expected);
+    qtest_quit(qts);
+}
+
