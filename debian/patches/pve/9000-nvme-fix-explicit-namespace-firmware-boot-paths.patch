+static void test_nvme_boot_path_updates(void)
+{
+    QTestState *qts = qtest_init(
+        "-M q35 -nodefaults " NVME_BOOT_ARGS
+        "-blockdev driver=null-co,node-name=disk,size=16777216 "
+        "-device nvme-ns,id=ns,bus=ctrl,drive=disk,nsid=10,bootindex=1");
+
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/peripheral/ns',"
+        " 'property': 'bootindex', 'value': 3 } }");
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, NVME_BOOT_CTRL "/namespace@a,0\n");
+
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/peripheral/ns',"
+        " 'property': 'bootindex', 'value': -1 } }");
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, "");
+
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/peripheral/ns',"
+        " 'property': 'bootindex', 'value': 1 } }");
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, NVME_BOOT_CTRL "/namespace@a,0\n");
+
+    /* QEMU 11.0 has no namespace hotplug; exercise its unrealize hook. */
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/peripheral/ns',"
+        " 'property': 'realized', 'value': false } }");
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, "");
+
+    qtest_quit(qts);
+}
+
+static void test_nvme_boot_path_controller_removal(void)
+{
+    QTestState *qts = qtest_init(
+        "-M pc -nodefaults " NVME_BOOT_ARGS
+        "-device nvme,id=path1,subsys=ss,serial=boot,addr=05,use-intel-id=off "
+        "-blockdev driver=null-co,node-name=disk,size=16777216 "
+        "-device nvme-ns,id=ns,bus=ctrl,drive=disk,nsid=10,bootindex=1");
+
+    qpci_unplug_acpi_device_test(qts, "ctrl", 4);
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, "/pci@i0cf8/pci1b36,0010@5/namespace@a,0\n");
+
+    qpci_unplug_acpi_device_test(qts, "path1", 5);
+    qtest_system_reset(qts);
+    assert_nvme_boot_path(qts, "");
+    qtest_quit(qts);
+}
