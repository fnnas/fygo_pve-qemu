+/*
+ * Namespaces are reparented to the subsystem bus during realization. Their
+ * firmware boot paths must still identify a PCI controller and the final NSID.
+ * Keep the bootindex property bound to that controller as well, so subsequent
+ * QOM changes and property release update the same entry.
+ */
+void nvme_ns_set_boot_controller(NvmeNamespace *ns, NvmeCtrl *n)
+{
+    int32_t bootindex = ns->bootindex;
+
+    object_property_del(OBJECT(ns), "bootindex");
+    ns->boot_ctrl = n;
+    snprintf(ns->bootindex_suffix, sizeof(ns->bootindex_suffix),
+             "/namespace@%" PRIx32 ",0", ns->params.nsid);
+    device_add_bootindex_property(OBJECT(ns), &ns->bootindex, "bootindex",
+                                 ns->bootindex_suffix,
+                                 n ? DEVICE(n) : DEVICE(ns));
+
+    /* Preserve the setting without advertising a missing controller. */
+    ns->bootindex = bootindex;
+    if (n && !ns->params.detached) {
+        add_boot_device_path(bootindex, DEVICE(n), ns->bootindex_suffix);
+    }
+}
+
 static void nvme_ns_unrealize(DeviceState *dev)
 {
     NvmeNamespace *ns = NVME_NS(dev);
+    NvmeSubsystem *subsys = ns->subsys;
+    uint32_t nsid = ns->params.nsid;
 
     nvme_ns_drain(ns);
     nvme_ns_shutdown(ns);
     nvme_ns_cleanup(ns);
+    nvme_ns_set_boot_controller(ns, NULL);
+
+    /* Symmetric with nvme_ns_realize() which sets subsys->namespaces[nsid]. */
+    if (subsys && nsid && subsys->namespaces[nsid] == ns) {
+        subsys->namespaces[nsid] = NULL;
+    }
 }
 
