+    for (i = 1; i <= NVME_MAX_NAMESPACES; i++) {
+        NvmeCtrl *replacement = NULL;
+        ns = nvme_subsys_ns(n->subsys, i);
+        if (!ns || ns->boot_ctrl != n) {
+            continue;
+        }
+        if (ns->params.shared) {
