Description: keep unsupported NVMe metadata out of SeaBIOS disk I/O
 SeaBIOS issues NVMe reads with a null metadata pointer. A namespace carrying
 metadata can therefore DMA into low memory while its partition table is
 probed, corrupting the interrupt vectors and BIOS data used to boot other
 devices. Skip metadata namespaces in firmware, leaving access to guest
 drivers with the required metadata support. Add a TCG boot regression with
 an unsupported namespace ahead of a conventional boot disk.
Forwarded: no

--- a/roms/seabios/src/hw/nvme.c
+++ b/roms/seabios/src/hw/nvme.c
@@ -260,6 +260,18 @@ nvme_probe_ns(struct nvme_ctrl *ctrl, u3
         goto free_buffer;
     }
 
+    struct nvme_lba_format *fmt = &id->lbaf[current_lba_format];
+    if (fmt->ms) {
+        /*
+         * INT 13h has no metadata buffer. Passing a null MPTR would DMA
+         * metadata into the interrupt vectors and BIOS data area, even
+         * when booting from another device. Leave this namespace to the OS.
+         */
+        dprintf(1, "NVMe NS %u: unsupported %u-byte metadata\n",
+                ns_id, fmt->ms);
+        goto free_buffer;
+    }
+
     if (!nvme_dma_buffer) {
         nvme_dma_buffer = zalloc_page_aligned(&ZoneHigh, NVME_PAGE_SIZE);
         if (!nvme_dma_buffer) {
@@ -278,8 +290,6 @@ nvme_probe_ns(struct nvme_ctrl *ctrl, u3
     ns->ns_id = ns_id;
     ns->lba_count = id->nsze;
 
-    struct nvme_lba_format *fmt = &id->lbaf[current_lba_format];
-
     ns->block_size    = 1U << fmt->lbads;
     ns->metadata_size = fmt->ms;
 
--- a/tests/qtest/bios-tables-test.c
+++ b/tests/qtest/bios-tables-test.c
@@ -2695,6 +2695,41 @@ static void test_acpi_loongarch64_virt_o
     g_free(args);
 }
 
+static void test_nvme_metadata_boot(void)
+{
+    g_autofree char *disk = g_build_filename(g_get_tmp_dir(),
+                                            "nvme-boot-XXXXXX", NULL);
+    QTestState *qts;
+    int64_t deadline;
+    uint16_t signature;
+
+    g_assert_cmpint(boot_sector_init(disk), ==, 0);
+    qts = qtest_initf("-machine q35 -accel tcg -accel kvm "
+                     "-drive if=none,id=boot,file=%s,format=raw "
+                     "-device ide-hd,drive=boot,bootindex=2 "
+                     "-blockdev driver=null-co,node-name=meta,size=67108864,"
+                     "read-zeroes=on "
+                     "-device nvme,id=nvme,serial=metadata "
+                     "-device nvme-ns,drive=meta,bus=nvme,ms=65535,bootindex=1",
+                     disk);
+
+    deadline = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
+    do {
+        /* The boot-sector helper writes 0xdead at 0x7c10. */
+        signature = qtest_readw(qts, 0x7c10);
+        if (signature == 0xdead) {
+            break;
+        }
+        g_usleep(10000);
+    } while (g_get_monotonic_time() < deadline);
+
+    g_assert_cmphex(signature, ==, 0xdead);
+    /* A metadata DMA to address zero must not erase conventional RAM size. */
+    g_assert_cmpuint(qtest_readw(qts, 0x413), >, 0);
+    qtest_quit(qts);
+    boot_sector_cleanup(disk);
+}
+
 int main(int argc, char *argv[])
 {
     const char *arch = qtest_get_arch();
@@ -2897,6 +2932,10 @@ int main(int argc, char *argv[])
                            test_acpi_loongarch64_virt_oem_fields);
         }
     }
+    if (qtest_has_machine("q35") && qtest_has_device("nvme-ns")) {
+        qtest_add_func("boot/nvme-metadata", test_nvme_metadata_boot);
+    }
+
     ret = g_test_run();
     boot_sector_cleanup(disk);
     return ret;
