+/*
+ * Native SD card identity, capacity and storage regressions.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qobject/qdict.h"
+#include "libqtest.h"
+#include "libqos/pci-pc.h"
+#include "hw/pci/pci.h"
+
+typedef struct SDTest {
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+    char *path;
+    int fd;
+    uint16_t rca;
+    bool high_capacity;
+} SDTest;
+
+typedef struct SDConfig {
+    const char *cid;
+    unsigned version;
+    uint64_t size;
+} SDConfig;
+
+static uint32_t sd_command(SDTest *s, unsigned cmd, uint32_t arg, bool data,
+                           bool read)
+{
+    unsigned response = cmd == 0 ? 0 :
+                        (cmd == 2 || cmd == 9 || cmd == 10 ? 1 : 2);
+
+    qpci_io_writew(s->dev, s->bar, 0x30, 0xffff);
+    qpci_io_writew(s->dev, s->bar, 0x32, 0xffff);
+    qpci_io_writew(s->dev, s->bar, 0x04, 512);
+    qpci_io_writew(s->dev, s->bar, 0x06, 1);
+    qpci_io_writel(s->dev, s->bar, 0x08, arg);
+    qpci_io_writew(s->dev, s->bar, 0x0c, 2 | (read ? 0x10 : 0));
+    qpci_io_writew(s->dev, s->bar, 0x0e,
+                   (cmd << 8) | response | (data ? 0x20 : 0));
+    g_assert_cmphex(qpci_io_readw(s->dev, s->bar, 0x32), ==, 0);
+    return qpci_io_readl(s->dev, s->bar, 0x10);
+}
+
+static void sd_read_r2(SDTest *s, uint8_t response[16])
+{
+    uint32_t words[4];
+
+    for (unsigned i = 0; i < 4; i++) {
+        words[i] = qpci_io_readl(s->dev, s->bar, 0x10 + (3 - i) * 4);
+    }
+    for (unsigned i = 0; i < 4; i++) {
+        stl_be_p(response + 4 * i,
+                 (words[i] << 8) | (i < 3 ? words[i + 1] >> 24 : 0));
+    }
+}
+
+static void sd_identify(SDTest *s, const SDConfig *config)
+{
+    uint32_t ocr = 0;
+    uint8_t cid[16], csd[16];
+
+    qpci_io_writeb(s->dev, s->bar, 0x2f, 1);
+    qpci_io_writew(s->dev, s->bar, 0x2c, 7);
+    qpci_io_writeb(s->dev, s->bar, 0x29, 0x0f);
+    qpci_io_writew(s->dev, s->bar, 0x34, 0xffff);
+    qpci_io_writew(s->dev, s->bar, 0x36, 0xffff);
+    sd_command(s, 0, 0, false, false);
+    g_assert_cmphex(sd_command(s, 8, 0x1aa, false, false), ==, 0x1aa);
+    for (unsigned i = 0; i < 100 && !(ocr & (1U << 31)); i++) {
+        sd_command(s, 55, 0, false, false);
+        ocr = sd_command(s, 41, 0x40ff8000, false, false);
+        qtest_clock_step(s->qts, 1000000);
+    }
+    g_assert_cmphex(ocr & (1U << 31), !=, 0);
+    s->high_capacity = ocr & (1U << 30);
+    g_assert_cmpint(s->high_capacity, ==, config->size > (2ULL << 30));
+    sd_command(s, 2, 0, false, false);
+    sd_read_r2(s, cid);
+    if (config->cid) {
+        for (unsigned i = 0; i < 15; i++) {
+            uint8_t expected =
+                (g_ascii_xdigit_value(config->cid[2 * i]) << 4) |
+                 g_ascii_xdigit_value(config->cid[2 * i + 1]);
+
+            g_assert_cmphex(cid[i], ==, expected);
+        }
+    } else {
+        g_assert_cmphex(cid[0], ==, 0xaa);
+    }
+    g_assert_cmphex(cid[15], ==, 0);
+    s->rca = sd_command(s, 3, 0, false, false) >> 16;
+    g_assert_cmphex(s->rca, !=, 0);
+    sd_command(s, 10, (uint32_t)s->rca << 16, false, false);
+    sd_read_r2(s, csd);
+    g_assert_cmpmem(cid, sizeof(cid), csd, sizeof(csd));
+    sd_command(s, 9, (uint32_t)s->rca << 16, false, false);
+    sd_read_r2(s, csd);
+    if (s->high_capacity) {
+        uint32_t csize = ((csd[7] & 0x3f) << 16) |
+                        (csd[8] << 8) | csd[9];
+
+        g_assert_cmpuint(((uint64_t)csize + 1) << 19, ==, config->size);
+    } else {
+        uint32_t csize = ((csd[6] & 3) << 10) | (csd[7] << 2) |
+                        (csd[8] >> 6);
+        unsigned mult = ((csd[9] & 3) << 1) | (csd[10] >> 7);
+
+        g_assert_cmpuint(((uint64_t)csize + 1) <<
+                         (mult + 2 + (csd[5] & 15)), ==, config->size);
+    }
+    sd_command(s, 7, (uint32_t)s->rca << 16, false, false);
+}
+
+static void sd_transfer(SDTest *s, uint32_t address, uint8_t data[512],
+                        bool read)
+{
+    sd_command(s, read ? 17 : 24, address, true, read);
+    for (unsigned i = 0; i < 512; i += 4) {
+        if (read) {
+            stl_le_p(data + i, qpci_io_readl(s->dev, s->bar, 0x20));
+        } else {
+            qpci_io_writel(s->dev, s->bar, 0x20, ldl_le_p(data + i));
+        }
+    }
+    qtest_clock_step(s->qts, 1000000);
+    g_assert_cmphex(qpci_io_readw(s->dev, s->bar, 0x32), ==, 0);
+}
+
+static void test_card(gconstpointer opaque)
+{
+    const SDConfig *config = opaque;
+    SDTest s = {};
+    uint8_t expected[512], actual[512];
+    g_autofree char *cid_arg = config->cid ?
+        g_strdup_printf(",cid=%s", config->cid) : g_strdup("");
+    uint32_t last;
+
+    s.fd = g_file_open_tmp("sdcard-test-XXXXXX", &s.path, NULL);
+    g_assert_cmpint(s.fd, >=, 0);
+    g_assert_cmpint(ftruncate(s.fd, config->size), ==, 0);
+    s.qts = qtest_initf("-machine pc -nodefaults "
+        "-device sdhci-pci,id=sdhci,addr=04.0,bootindex=7 "
+        "-device sd-card,id=card,drive=d0,spec_version=%u%s "
+        "-drive if=none,id=d0,file=%s,format=raw",
+        config->version, cid_arg, s.path);
+    s.bus = qpci_new_pc(s.qts, NULL);
+    s.dev = qpci_device_find(s.bus, QPCI_DEVFN(4, 0));
+    g_assert_nonnull(s.dev);
+    s.bar = qpci_iomap(s.dev, 0, NULL);
+    qpci_device_enable(s.dev);
+    for (unsigned pass = 0; pass < 2; pass++) {
+        if (pass) {
+            qtest_qmp_assert_success(s.qts, "{'execute':'system_reset'}");
+            s.bar = qpci_iomap(s.dev, 0, NULL);
+            qpci_device_enable(s.dev);
+        }
+        sd_identify(&s, config);
+        memset(expected, 0x5a + pass, sizeof(expected));
+        last = s.high_capacity ? config->size / 512 - 1 : config->size - 512;
+        sd_transfer(&s, last, expected, false);
+        sd_transfer(&s, last, actual, true);
+        g_assert_cmpmem(actual, sizeof(actual), expected, sizeof(expected));
+        if (config->cid) {
+            QDict *reply = qtest_qmp(s.qts,
+                "{'execute':'qom-get','arguments':"
+                "{'path':'/machine/peripheral/card','property':'cid'}}");
+
+            g_assert_cmpstr(qdict_get_str(reply, "return"), ==, config->cid);
+            qobject_unref(reply);
+        }
+    }
+    qpci_free_pc(s.bus);
+    qtest_quit(s.qts);
+    close(s.fd);
+    g_unlink(s.path);
+    g_free(s.path);
+    g_free(s.dev);
+}
+
+static void test_invalid_cid(gconstpointer opaque)
+{
+    const char *cid = opaque;
+
+    if (g_test_subprocess()) {
+        g_autofree char *command = g_strdup_printf(
+            "-machine pc -nodefaults -device sdhci-pci "
+            "-device 'sd-card,cid=%s'", cid);
+
+        QTestState *qts = qtest_init(command);
+
+        qtest_quit(qts);
+        return;
+    }
+    g_test_trap_subprocess(NULL, 10 * G_USEC_PER_SEC, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*SD card cid must contain exactly 32 "
+                             "hexadecimal characters*");
+}
+
+int main(int argc, char **argv)
+{
+    static const SDConfig cases[] = {
+        { NULL, 3, 64ULL << 20 },
+        { "03534453443332478535bca2a70195df", 3, 64ULL << 20 },
+        { "00000aBc00000aBc00000aBc00000aBc", 2, 64ULL << 20 },
+        { NULL, 2, 256ULL << 10 },
+        { NULL, 3, 2ULL << 30 },
+        { NULL, 3, 3ULL << 30 },
+        { NULL, 3, 2ULL << 40 },
+    };
+    static const char *invalid[] = {
+        "", "a", "03534453443332478535bca2a70195dfff",
+        "03534453443332478535bca2a70195dg",
+        "0x534453443332478535bca2a70195df",
+        "03534453443332478535bca2a70195df\n",
+    };
+
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned i = 0; i < G_N_ELEMENTS(cases); i++) {
+        g_autofree char *name = g_strdup_printf("sdcard/config/%u", i);
+
+        qtest_add_data_func(name, &cases[i], test_card);
+    }
+    for (unsigned i = 0; i < G_N_ELEMENTS(invalid); i++) {
+        g_autofree char *name = g_strdup_printf("sdcard/invalid-cid/%u", i);
+
+        qtest_add_data_func(name, invalid[i], test_invalid_cid);
+    }
+    return g_test_run();
+}
