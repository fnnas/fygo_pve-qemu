+static void emmc_read_r2(EMMCTest *s, uint8_t response[16])
+{
+    /* SDHCI omits the CRC byte, as does Linux's raw_cid representation. */
+    for (unsigned i = 0; i < 4; i++) {
+        unsigned offset = 0x10 + (3 - i) * 4;
+        uint32_t word = qpci_io_readl(s->dev, s->bar, offset) << 8;
+
+        if (i != 3) {
+            word |= qpci_io_readb(s->dev, s->bar, offset - 1);
+        }
+        stl_be_p(response + i * 4, word);
+    }
+}
+
+static void test_cid(gconstpointer opaque)
+{
+    const char *cid = opaque;
+    const uint8_t default_cid[16] = {
+        0xaa, 0x01, 'X', 'Q', 'E', 'M', 'U', '!', '!', 0x01,
+        0xde, 0xad, 0xbe, 0xef, 0x29, 0x00,
+    };
+    EMMCTest s = {};
+    uint8_t expected[16], response[16];
+
+    memcpy(expected, default_cid, sizeof(expected));
+    if (cid) {
+        for (unsigned i = 0; i < 15; i++) {
+            expected[i] = (g_ascii_xdigit_value(cid[2 * i]) << 4) |
+                          g_ascii_xdigit_value(cid[2 * i + 1]);
+        }
+        expected[15] = 0;
+    }
+    emmc_init_with_cid(&s, cid);
+    for (unsigned round = 0; round < 2; round++) {
+        uint32_t ocr = 0;
+
+        if (round) {
+            qtest_system_reset(s.qts);
+            s.bar = qpci_iomap(s.dev, 0, NULL);
+            qpci_device_enable(s.dev);
+        }
+        qpci_io_writeb(s.dev, s.bar, 0x2f, 1);
+        qpci_io_writew(s.dev, s.bar, 0x2c, 7);
+        qpci_io_writeb(s.dev, s.bar, 0x29, 0x0f);
+        emmc_command(&s, 0, 0, false, 0, false);
+        for (unsigned i = 0; i < 100 && !(ocr & (1U << 31)); i++) {
+            ocr = emmc_command(&s, 1, 0x40ff8000, false, 0, false);
+            qtest_clock_step(s.qts, 1000000);
+        }
+        g_assert_cmphex(ocr & (1U << 31), !=, 0);
+        emmc_command(&s, 2, 0, false, 0, false);
+        emmc_read_r2(&s, response);
+        g_assert_cmpmem(response, sizeof(response), expected, sizeof(expected));
+        emmc_command(&s, 3, 1U << 16, false, 0, false);
+        emmc_command(&s, 10, 1U << 16, false, 0, false);
+        emmc_read_r2(&s, response);
+        g_assert_cmpmem(response, sizeof(response), expected, sizeof(expected));
+    }
+    if (cid) {
+        QDict *reply = qtest_qmp(s.qts,
+            "{'execute':'qom-get','arguments':{"
+            "'path':'/machine/peripheral/emmc','property':'cid'}}");
+
+        g_assert_cmpstr(qdict_get_str(reply, "return"), ==, cid);
+        qobject_unref(reply);
+    }
+    emmc_cleanup(&s);
+}
