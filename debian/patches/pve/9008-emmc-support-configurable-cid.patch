@@ -480,6 +481,15 @@ static void sd_set_cid(SDState *sd)
 
 static void emmc_set_cid(SDState *sd)
 {
+    if (sd->cid_config) {
+        /* Validated before realize; restore the configured CID on reset. */
+        for (unsigned i = 0; i < sizeof(sd->cid); i++) {
+            sd->cid[i] = (g_ascii_xdigit_value(sd->cid_config[2 * i]) << 4) |
+                         g_ascii_xdigit_value(sd->cid_config[2 * i + 1]);
+        }
+        return;
+    }
+
     sd->cid[0] = MID;       /* Fake card manufacturer ID (MID) */
     sd->cid[1] = 0b01;      /* CBX: soldered BGA */
     sd->cid[2] = OID[0];    /* OEM/Application ID (OID) */
@@ -3213,6 +3223,21 @@ static void emmc_realize(DeviceState *de
 {
     SDState *sd = SDMMC_COMMON(dev);
 
+    if (sd->cid_config) {
+        if (strlen(sd->cid_config) != 2 * sizeof(sd->cid)) {
+            error_setg(errp,
+                       "eMMC cid must contain exactly 32 hexadecimal characters");
+            return;
+        }
+        for (unsigned i = 0; i < 2 * sizeof(sd->cid); i++) {
+            if (!g_ascii_isxdigit(sd->cid_config[i])) {
+                error_setg(errp,
+                           "eMMC cid must contain exactly 32 hexadecimal characters");
+                return;
+            }
+        }
+    }
+
