Description: preserve unwritten NVMe protection information after DSM
 Dataset Management must retain an unwritten protection tuple after deallocation.
 Zero metadata fails reference checks once an adjacent write allocates the same
 host extent. Persist the marker in bounded writes for protected namespaces,
 including backends that ignore discard, while keeping unprotected behavior.
 Cover deallocation followed by a neighboring write and protected read in qtest.
Forwarded: no

--- a/hw/nvme/ctrl.c
+++ b/hw/nvme/ctrl.c
@@ -2514,6 +2514,11 @@ typedef struct NvmeDSMAIOCB {
     NvmeDsmRange *range;
     unsigned int nr;
     unsigned int idx;
+
+    QEMUIOVector mdata_iov;
+    uint8_t *mdata;
+    uint64_t mdata_offset;
+    uint64_t mdata_remaining;
 } NvmeDSMAIOCB;
 
 static void nvme_dsm_cancel(BlockAIOCB *aiocb)
@@ -2543,6 +2548,29 @@ static const AIOCBInfo nvme_dsm_aiocb_in
 
 static void nvme_dsm_cb(void *opaque, int ret);
 
+/* Keep memory bounded even for large DSM ranges and metadata formats. */
+static void nvme_dsm_pi_cb(void *opaque, int ret)
+{
+    NvmeDSMAIOCB *iocb = opaque;
+    size_t length;
+
+    if (ret < 0 || iocb->ret < 0 || !iocb->mdata_remaining) {
+        qemu_iovec_destroy(&iocb->mdata_iov);
+        g_free(iocb->mdata);
+        nvme_dsm_cb(iocb, ret);
+        return;
+    }
+
+    length = MIN(iocb->mdata_iov.size, iocb->mdata_remaining);
+    iocb->mdata_iov.iov[0].iov_len = length;
+    iocb->mdata_iov.size = length;
+    iocb->mdata_remaining -= length;
+    iocb->aiocb = blk_aio_pwritev(iocb->req->ns->blkconf.blk,
+                                iocb->mdata_offset, &iocb->mdata_iov, 0,
+                                nvme_dsm_pi_cb, iocb);
+    iocb->mdata_offset += length;
+}
+
 static void nvme_dsm_md_cb(void *opaque, int ret)
 {
     NvmeDSMAIOCB *iocb = opaque;
@@ -2560,6 +2588,29 @@ static void nvme_dsm_md_cb(void *opaque,
     slba = le64_to_cpu(range->slba);
     nlb = le32_to_cpu(range->nlb);
 
+    if (NVME_ID_NS_DPS_TYPE(ns->id_ns.dps)) {
+        size_t length = MIN(nlb, 64 * KiB / ns->lbaf.ms) * ns->lbaf.ms;
+        size_t pil = ns->id_ns.dps & NVME_ID_NS_DPS_FIRST_EIGHT ?
+            0 : ns->lbaf.ms - nvme_pi_tuple_size(ns);
+
+        /*
+         * Mark deallocated LBAs as unwritten. Zero PI contains invalid
+         * reference tags. Synthesizing the marker only while the data is a
+         * sparse zero loses it when a neighboring write allocates the extent.
+         * This is also needed when the backend ignores discard requests.
+         */
+        iocb->mdata = g_malloc0(length);
+        for (size_t pos = pil; pos < length; pos += ns->lbaf.ms) {
+            memset(iocb->mdata + pos, 0xff, nvme_pi_tuple_size(ns));
+        }
+        qemu_iovec_init(&iocb->mdata_iov, 1);
+        qemu_iovec_add(&iocb->mdata_iov, iocb->mdata, length);
+        iocb->mdata_offset = nvme_moff(ns, slba);
+        iocb->mdata_remaining = nvme_m2b(ns, nlb);
+        nvme_dsm_pi_cb(iocb, 0);
+        return;
+    }
+
     /*
      * Check that all block were discarded (zeroed); otherwise we do not zero
      * the metadata.
--- a/tests/qtest/nvme-test.c
+++ b/tests/qtest/nvme-test.c
@@ -8,6 +8,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/bswap.h"
 #include "qemu/module.h"
 #include "qemu/units.h"
 #include "libqtest.h"
@@ -142,6 +143,333 @@ static void nvmetest_pmr_reg_test(void *
     qpci_iounmap(pdev, pmr_bar);
 }
 
+typedef struct nvme_ctrl nvme_ctrl;
+
+typedef struct nvme_queue {
+    nvme_ctrl *ctrl;
+    uint64_t doorbell;
+    uint32_t size;
+} nvme_queue;
+
+typedef struct nvme_cq {
+    nvme_queue common;
+    uint64_t phys_cqe; /* NvmeCqe* */
+    uint16_t head;
+    uint8_t phase;
+} nvme_cq;
+
+typedef struct nvme_sq {
+    nvme_queue common;
+    uint64_t phys_sqe; /* NvmeCmd* */
+    nvme_cq *cq;
+    uint16_t head;
+    uint16_t tail;
+} nvme_sq;
+
+struct nvme_ctrl {
+    QGuestAllocator *alloc;
+    QPCIDevice *pdev;
+    QPCIBar bar;
+
+    uint32_t db_stride;
+
+    nvme_sq admin_sq;
+    nvme_cq admin_cq;
+};
+
+#define PHYS_ADDR_OF_FIELD(T, base_phys_addr, field) \
+    ((uint64_t)&((T *)(base_phys_addr))->field)
+
+#define PHYS_ADDR_OF(T, base_phys_addr, accessor) \
+    ((uint64_t)&((T *)(base_phys_addr))accessor)
+
+static void nvme_init_queue_common(nvme_ctrl *ctrl, nvme_queue *q,
+                                   uint16_t db_idx, uint32_t size)
+{
+    q->ctrl = ctrl;
+    q->doorbell = (sizeof(NvmeBar) + db_idx * ctrl->db_stride);
+    g_test_message(" q %p db_idx %u doorbell 0x%" PRIx64, q, db_idx, q->doorbell);
+    q->size = size;
+}
+
+static void nvme_init_sq(nvme_ctrl *ctrl, nvme_sq *sq, uint16_t db_idx,
+                         uint32_t size, nvme_cq *cq)
+{
+    nvme_init_queue_common(ctrl, &sq->common, db_idx, size);
+
+    sq->phys_sqe = guest_alloc(ctrl->alloc, sizeof(NvmeCmd) * size);
+    g_assert(sq->phys_sqe);
+
+    g_test_message("sq %p db_idx %u sqe 0x%" PRIx64, sq, db_idx, sq->phys_sqe);
+    sq->cq = cq;
+    sq->head = 0;
+    sq->tail = 0;
+}
+
+static void nvme_init_cq(nvme_ctrl *ctrl, nvme_cq *cq, uint16_t db_idx,
+                         uint32_t size)
+{
+    nvme_init_queue_common(ctrl, &cq->common, db_idx, size);
+
+    cq->phys_cqe = guest_alloc(ctrl->alloc, sizeof(NvmeCqe) * size);
+    g_assert(cq->phys_cqe);
+
+    g_test_message("cq %p db_idx %u cqe 0x%" PRIx64, cq, db_idx, cq->phys_cqe);
+    cq->head = 0;
+    cq->phase = 1;
+}
+
+static int nvme_cqe_pending(nvme_cq *cq)
+{
+    uint16_t status = qtest_readw(
+        cq->common.ctrl->pdev->bus->qts,
+        PHYS_ADDR_OF(NvmeCqe, cq->phys_cqe, [cq->head].status));
+    return (status & 1) == cq->phase;
+}
+
+static int nvme_is_cqe_success(NvmeCqe *cqe)
+{
+    return (le16_to_cpu(cqe->status) >> 1) == NVME_SUCCESS;
+}
+
+static NvmeCqe nvme_handle_cqe(nvme_sq *sq)
+{
+    nvme_cq *cq = sq->cq;
+    uint64_t phys_cqe = PHYS_ADDR_OF(
+                            NvmeCqe, cq->phys_cqe, [cq->head]); /* NvmeCqe* */
+    NvmeCqe cqe;
+    uint16_t cq_next_head;
+
+    g_assert(nvme_cqe_pending(cq));
+
+    qtest_memread(sq->common.ctrl->pdev->bus->qts, phys_cqe, &cqe, sizeof(cqe));
+
+    cq_next_head = (cq->head + 1) % cq->common.size;
+    g_test_message("cq %p head %u -> %u", cq, cq->head, cq_next_head);
+    if (cq_next_head < cq->head) {
+        cq->phase ^= 1;
+    }
+    cq->head = cq_next_head;
+
+    if (cqe.sq_head != sq->head) {
+        sq->head = cqe.sq_head;
+        g_test_message("sq %p head = %u", sq, sq->head);
+    }
+
+    qpci_io_writel(cq->common.ctrl->pdev, cq->common.ctrl->bar,
+                   cq->common.doorbell, cq->head);
+
+    return cqe;
+}
+
+static NvmeCqe nvme_wait(nvme_sq *sq)
+{
+    int i;
+    bool ready = false;
+
+    for (i = 0; i < 10; i++) {
+        if (nvme_cqe_pending(sq->cq)) {
+            ready = true;
+            break;
+        }
+
+        g_usleep(1000);
+    }
+
+    g_assert(ready);
+
+    return nvme_handle_cqe(sq);
+}
+
+static uint64_t nvme_get_next_sqe(nvme_sq *sq, uint8_t opcode,
+                                  uint16_t cid, uint64_t prp1)
+{
+    uint64_t phys_sqe = PHYS_ADDR_OF(NvmeCmd, sq->phys_sqe, [sq->tail]);
+
+    if (((sq->tail + 1) % sq->common.size) == sq->head) {
+        /* no space in SQ */
+        g_test_message("%s head %d tail %d", __func__, sq->head, sq->tail);
+        g_assert_not_reached();
+        return 0;
+    }
+
+    qtest_memset(sq->common.ctrl->pdev->bus->qts,
+                 phys_sqe, 0, sizeof(NvmeCmd));
+
+    #define GUEST_MEM_WRITE(fn, phys_addr, val) \
+        fn(sq->common.ctrl->pdev->bus->qts, phys_addr, (val))
+
+    GUEST_MEM_WRITE(qtest_writeb,
+                    PHYS_ADDR_OF_FIELD(NvmeCmd, phys_sqe, opcode), opcode);
+    GUEST_MEM_WRITE(qtest_writew,
+                    PHYS_ADDR_OF_FIELD(NvmeCmd, phys_sqe, cid), cid);
+    GUEST_MEM_WRITE(qtest_writeq,
+                    PHYS_ADDR_OF_FIELD(NvmeCmd, phys_sqe, dptr.prp1), prp1);
+
+    #undef GUEST_MEM_WRITE
+
+    g_test_message("sq %p next_sqe %u sqe 0x%" PRIx64, sq, sq->tail, phys_sqe);
+    return phys_sqe;
+}
+
+static void nvme_commit_sqe(nvme_sq *sq)
+{
+    g_test_message("sq %p commit sqe tail %u", sq, sq->tail);
+    sq->tail = (sq->tail + 1) % sq->common.size;
+    qpci_io_writel(sq->common.ctrl->pdev, sq->common.ctrl->bar,
+                   sq->common.doorbell, sq->tail);
+}
+
+static void nvme_wait_ready(nvme_ctrl *ctrl, int val)
+{
+    int i;
+
+    for (i = 0; i < 10; i++) {
+        uint32_t csts = qpci_io_readl(ctrl->pdev, ctrl->bar, NVME_REG_CSTS);
+        g_test_message("%s: csts %x", __func__, csts);
+
+        if (NVME_CSTS_RDY(csts) == val) {
+            return;
+        }
+
+        g_usleep(1000);
+    }
+
+    g_assert_not_reached();
+}
+
+static void nvme_pi_setup_ctrl(nvme_ctrl *ctrl)
+{
+    uint64_t cap;
+
+    /* disable controller */
+    qpci_io_writel(ctrl->pdev, ctrl->bar, NVME_REG_CC, 0);
+    nvme_wait_ready(ctrl, 0);
+
+    cap = qpci_io_readq(ctrl->pdev, ctrl->bar, NVME_REG_CAP);
+    ctrl->db_stride = 4 << NVME_CAP_DSTRD(cap);
+
+    nvme_init_cq(ctrl, &ctrl->admin_cq, 1, 2 /* CQEs num */);
+    nvme_init_sq(ctrl, &ctrl->admin_sq, 0, 4 /* SQEs num */, &ctrl->admin_cq);
+
+    qpci_io_writel(ctrl->pdev, ctrl->bar, NVME_REG_AQA,
+        ((ctrl->admin_cq.common.size - 1) << AQA_ACQS_SHIFT) |
+        ((ctrl->admin_sq.common.size - 1) << AQA_ASQS_SHIFT)
+    );
+
+    qpci_io_writeq(ctrl->pdev, ctrl->bar,
+                   NVME_REG_ASQ, (uint64_t)ctrl->admin_sq.phys_sqe);
+    qpci_io_writeq(ctrl->pdev, ctrl->bar,
+                   NVME_REG_ACQ, (uint64_t)ctrl->admin_cq.phys_cqe);
+
+    /* enable controller */
+    {
+        uint32_t cc = 0;
+        NVME_SET_CC_EN(cc, 1);
+        qpci_io_writel(ctrl->pdev, ctrl->bar, NVME_REG_CC, cc);
+    }
+
+    nvme_wait_ready(ctrl, 1);
+}
+
+static void nvme_pi_image_destroy(void *opaque)
+{
+    g_unlink(opaque);
+    g_free(opaque);
+    qos_invalidate_command_line();
+}
+
+static void *nvme_pi_test_setup(GString *cmd_line, void *arg)
+{
+    char *path;
+    int fd = g_file_open_tmp("nvme-pi-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, 8 * MiB), ==, 0);
+    close(fd);
+    g_test_queue_destroy(nvme_pi_image_destroy, path);
+
+    g_string_append_printf(cmd_line,
+        " -drive if=none,id=pi-drive,file=%s,format=raw,discard=%s"
+        " -device nvme-ns,drive=pi-drive,bus=pi-ctrl,nsid=2,ms=8,pi=1",
+        path, arg ? "unmap" : "ignore");
+    return NULL;
+}
+
+static void nvmetest_pi_discard(void *obj, void *data, QGuestAllocator *alloc)
+{
+    QNvme *nvme = obj;
+    nvme_ctrl ctrl = { .alloc = alloc, .pdev = &nvme->dev };
+    nvme_cq cq;
+    nvme_sq sq;
+    NvmeCqe cqe;
+    /* Cross the 64 KiB metadata chunk boundary with a partial final chunk. */
+    NvmeDsmRange range = { .nlb = cpu_to_le32(8201),
+                           .slba = cpu_to_le64(128) };
+    uint64_t buffer = guest_alloc(alloc, 4096);
+    uint64_t command;
+    QTestState *qts = ctrl.pdev->bus->qts;
+
+    qpci_device_enable(ctrl.pdev);
+    ctrl.bar = qpci_iomap(ctrl.pdev, 0, NULL);
+    nvme_pi_setup_ctrl(&ctrl);
+    qpci_io_writel(ctrl.pdev, ctrl.bar, NVME_REG_CC, 0x00460001);
+    nvme_init_cq(&ctrl, &cq, 3, 16);
+    nvme_init_sq(&ctrl, &sq, 2, 16, &cq);
+
+    command = nvme_get_next_sqe(&ctrl.admin_sq, NVME_ADM_CMD_CREATE_CQ,
+                                1, cq.phys_cqe);
+    qtest_writel(qts, command + 40, (15 << 16) | 1);
+    qtest_writel(qts, command + 44, 1);
+    nvme_commit_sqe(&ctrl.admin_sq);
+    cqe = nvme_wait(&ctrl.admin_sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+
+    command = nvme_get_next_sqe(&ctrl.admin_sq, NVME_ADM_CMD_CREATE_SQ,
+                                2, sq.phys_sqe);
+    qtest_writel(qts, command + 40, (15 << 16) | 1);
+    qtest_writel(qts, command + 44, (1 << 16) | 1);
+    nvme_commit_sqe(&ctrl.admin_sq);
+    cqe = nvme_wait(&ctrl.admin_sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+
+    qtest_memwrite(qts, buffer, &range, sizeof(range));
+    command = nvme_get_next_sqe(&sq, NVME_CMD_DSM, 3, buffer);
+    qtest_writel(qts, command + 4, 2);
+    qtest_writel(qts, command + 44, NVME_DSMGMT_AD);
+    nvme_commit_sqe(&sq);
+    cqe = nvme_wait(&sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+
+    /* Allocate the host extent containing the adjacent, unwritten LBA. */
+    qtest_memset(qts, buffer, 0x5a, 512);
+    command = nvme_get_next_sqe(&sq, NVME_CMD_WRITE, 4, buffer);
+    qtest_writel(qts, command + 4, 2);
+    qtest_writeq(qts, command + 40, 128);
+    qtest_writel(qts, command + 48, NVME_RW_PRINFO_PRACT << 16);
+    qtest_writel(qts, command + 56, 128);
+    nvme_commit_sqe(&sq);
+    cqe = nvme_wait(&sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+
+    command = nvme_get_next_sqe(&sq, NVME_CMD_READ, 5, buffer);
+    qtest_writel(qts, command + 4, 2);
+    qtest_writeq(qts, command + 40, 129);
+    qtest_writel(qts, command + 48,
+        (NVME_RW_PRINFO_PRACT | NVME_RW_PRINFO_PRCHK_REF) << 16);
+    qtest_writel(qts, command + 56, 129);
+    nvme_commit_sqe(&sq);
+    cqe = nvme_wait(&sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+
+    qpci_iounmap(ctrl.pdev, ctrl.bar);
+    guest_free(alloc, buffer);
+    guest_free(alloc, sq.phys_sqe);
+    guest_free(alloc, cq.phys_cqe);
+    guest_free(alloc, ctrl.admin_sq.phys_sqe);
+    guest_free(alloc, ctrl.admin_cq.phys_cqe);
+}
+
 static void nvme_register_nodes(void)
 {
     QOSGraphEdgeOptions opts = {
@@ -168,6 +496,17 @@ static void nvme_register_nodes(void)
     });
 
     qos_add_test("reg-read", "nvme", nvmetest_reg_read_test, NULL);
+    qos_add_test("pi-discard-unmap", "nvme", nvmetest_pi_discard,
+        &(QOSGraphTestOptions) {
+            .before = nvme_pi_test_setup,
+            .arg = GINT_TO_POINTER(1),
+            .edge.extra_device_opts = "id=pi-ctrl",
+        });
